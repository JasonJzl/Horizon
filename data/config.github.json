{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 6,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news",
      "category": "ai-tools"
    },
    "rss": [
      {
        "name": "Abnormal Returns",
        "url": "https://abnormalreturns.com/feed/",
        "enabled": true,
        "category": "quant",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "arXiv q-fin (Quantitative Finance)",
        "url": "https://rss.arxiv.org/rss/q-fin",
        "enabled": true,
        "category": "quant-research",
        "profile": "tech-blog"
      },
      {
        "name": "Alpha Architect",
        "url": "https://alphaarchitect.com/feed/",
        "enabled": true,
        "category": "quant",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Federal Reserve Press Releases",
        "url": "https://www.federalreserve.gov/feeds/press_all.xml",
        "enabled": true,
        "category": "macro",
        "profile": "finance-news"
      },
      {
        "name": "MarketWatch Top Stories",
        "url": "https://feeds.content.dowjones.io/public/rss/mw_topstories",
        "enabled": true,
        "category": "equities",
        "profile": "finance-news"
      },
      {
        "name": "CoinDesk",
        "url": "https://www.coindesk.com/arc/outboundfeeds/rss/",
        "enabled": true,
        "category": "crypto",
        "profile": "finance-news"
      },
      {
        "name": "Cointelegraph",
        "url": "https://cointelegraph.com/rss",
        "enabled": true,
        "category": "crypto",
        "profile": "finance-news"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "algotrading",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "profile": "tech-blog",
          "category": "quant"
        },
        {
          "subreddit": "quant",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 20,
          "profile": "tech-blog",
          "category": "quant"
        },
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news",
          "category": "ai-tools"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news",
          "category": "ai-tools"
        },
        {
          "subreddit": "CryptoCurrency",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 500,
          "profile": "finance-news",
          "category": "crypto"
        }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "github": [
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "qlib",
        "enabled": true,
        "category": "quant",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "nautechsystems",
        "repo": "nautilus_trader",
        "enabled": true,
        "category": "quant",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "OpenBB-finance",
        "repo": "OpenBB",
        "enabled": true,
        "category": "quant",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "ranaroussi",
        "repo": "yfinance",
        "enabled": true,
        "category": "quant",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "freqtrade",
        "repo": "freqtrade",
        "enabled": true,
        "category": "quant",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      }
    ],
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "profile": "tech-news"
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "megacaps",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "equities",
          "symbols": [
            "AAPL",
            "MSFT",
            "NVDA",
            "GOOGL",
            "AMZN",
            "META",
            "TSLA"
          ],
          "profile": "finance-news"
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {
      "quant": {
        "limit": 6,
        "categories": [
          "quant",
          "quant-research"
        ]
      },
      "finance": {
        "limit": 5,
        "categories": [
          "finance",
          "macro",
          "equities"
        ]
      },
      "crypto": {
        "limit": 3,
        "categories": [
          "crypto"
        ]
      },
      "ai": {
        "limit": 6,
        "categories": [
          "ai-tools",
          "github-trending"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 5
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "generic",
    "layout": "markdown"
  }
}
